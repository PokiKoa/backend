DJANGO_SETTINGS_MODULE=poki_koa.settings.dev
DEBUG=True
SECRET_KEY=replace-with-a-random-50-char-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://poki_koa:poki_koa@localhost:5432/poki_koa
REDIS_URL=redis://localhost:6379/0
LOGIN_THROTTLE_RATE=5/min
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=8
