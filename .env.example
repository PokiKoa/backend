DJANGO_SETTINGS_MODULE=poki_koa.settings.dev
DEBUG=True
# Contraseña de los usuarios de seed_demo. Vacía = admin2026 / Clinica#2026, solo con DEBUG=True;
# con DEBUG=False es obligatoria y debe cumplir la política de contraseñas
SEED_DEMO_PASSWORD=
SECRET_KEY=replace-with-a-random-50-char-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://poki_koa:poki_koa@localhost:5432/poki_koa
REDIS_URL=redis://localhost:6379/0
LOGIN_THROTTLE_RATE=5/min
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=8
# Cookie httpOnly del refresh token; usar None (con HTTPS) si el frontend está en otro sitio
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=False
