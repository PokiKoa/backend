# Configuración de producción para docker-compose.prod.yml.
# Copiar a .env junto al compose (cp .env.prod.example .env), completar y NUNCA versionar.
# Los valores CAMBIAR_* son marcadores: compose no los rechaza, pero no deben llegar así a producción.

# --- Obligatorias (compose se detiene si faltan) ---------------------------------------------

# Firma JWT y sesiones. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CAMBIAR_clave_secreta_aleatoria_de_al_menos_50_caracteres

# Contraseña de PostgreSQL (solo la usa la red interna de compose). Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CAMBIAR_contrasena_postgres

# Dominios que Django acepta en la cabecera Host, separados por coma. El PRIMERO debe ser
# un nombre concreto: lo usa el healthcheck del contenedor.
ALLOWED_HOSTS=pokikoa.racsu.com

# Orígenes del frontend autorizados (CORS y WebSockets), con esquema y sin barra final.
# Con el frontend en el mismo dominio basta el propio dominio.
CORS_ALLOWED_ORIGINS=https://pokikoa.racsu.com

# --- Recomendadas -----------------------------------------------------------------------------

# Orígenes de confianza para formularios con CSRF (admin de Django). Por defecto, CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=https://pokikoa.racsu.com

# Proxies inversos propios delante de la API (Caddy en el host = 1). Define qué entrada de
# X-Forwarded-For se usa como IP del cliente en la auditoría y el límite de login.
# 0 solo si la API se expone sin proxy.
TRUSTED_PROXY_COUNT=1

# Cookie httpOnly del refresh token. En prod.py siempre es Secure (HTTPS).
# Lax sirve cuando frontend y API comparten dominio (pokikoa.racsu.com). Usar None solo si
# el frontend está en otro sitio; DOMAIN vacío = el host exacto de la API.
REFRESH_COOKIE_NAME=poki_refresh
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_DOMAIN=

# Nivel de logs de Django en consola (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# --- Opcionales -------------------------------------------------------------------------------

# Puerto de 127.0.0.1 en el host donde escucha la API para el proxy (no se publica a internet).
APP_HOST_PORT=8000

# Procesos de uvicorn.
WEB_CONCURRENCY=2

# Base de datos (el host siempre es el servicio db de compose).
POSTGRES_DB=poki_koa
POSTGRES_USER=poki_koa

# Redirección HTTP -> HTTPS de Django. Mantener True detrás de Caddy (envía X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True

# Sesión: duración del access token (minutos) y del refresh token (horas).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=8
LOGIN_THROTTLE_RATE=5/min

# Solo para cargar datos ficticios con seed_demo en producción: contraseña de los cuatro
# usuarios de demostración (debe cumplir la política de contraseñas). Vacía = seed_demo falla.
SEED_DEMO_PASSWORD=

TZ=America/Santiago
